<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- The Intel app's bundled Python only: as entitlements.plist, and on Intel unicorn maps its
	     translator buffer writable and executable without MAP_JIT, which the hardened runtime
	     refuses without allow-unsigned-executable-memory ("Could not allocate dynamic translator
	     buffer"). -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
	<key>com.apple.security.cs.allow-unsigned-executable-memory</key>
	<true/>
</dict>
</plist>
