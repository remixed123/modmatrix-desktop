<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- For the bundled Python only: unicorn (the firmware emulator the build check runs)
	     translates code at run time. Without it: "Could not allocate dynamic translator buffer". -->
	<key>com.apple.security.cs.allow-jit</key>
	<true/>
</dict>
</plist>
